# 生产环境变量示例（复制为 .env.prod 并修改；不要提交真实密钥）
WXBST_ENV=production
WXBST_STORAGE=sqlite
WXBST_DB_PATH=/data/wxbst.db
WXBST_AUTH_MODE=token
WXBST_API_TOKENS=replace-with-long-random-token:admin
WXBST_TRUST_PROXY=1
WXBST_HSTS=1
WXBST_LOG_FORMAT=json
WXBST_AUDIT_RETENTION_DAYS=30
WXBST_PROMPTS_DIR=/app/prompts
# 可选：大模型与远端向量（不配置则离线运行）
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=
# EMBED_API_BASE=
# EMBED_API_KEY=
# EMBED_MODEL=
