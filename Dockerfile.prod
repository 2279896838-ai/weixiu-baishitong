# 维修百事通生产镜像：非 root、只读根文件系统（compose 中启用）、/data 持久卷
FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    WXBST_ENV=production \
    WXBST_STORAGE=sqlite \
    WXBST_DB_PATH=/data/wxbst.db \
    WXBST_PROMPTS_DIR=/app/prompts \
    PORT=8787
WORKDIR /app
RUN groupadd --system --gid 10001 wxbst && useradd --system --uid 10001 --gid wxbst --home-dir /app wxbst
COPY demo ./demo
COPY data ./data
COPY prompts ./prompts
COPY VERSION README.md LICENSE ./
RUN mkdir -p /data /app/demo/runtime && chown -R wxbst:wxbst /data /app
USER wxbst
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD python -c "import urllib.request,sys; r=urllib.request.urlopen('http://127.0.0.1:8787/api/health', timeout=3); sys.exit(0 if r.status==200 else 1)"
CMD ["python", "demo/server.py", "--host", "0.0.0.0", "--port", "8787"]
