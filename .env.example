# 服务端口
PORT=8787

# 可选：OpenAI 兼容大模型（三者齐全才启用，否则使用离线检索与模板合成）
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=sk-请替换
LLM_MODEL=deepseek-chat

# 可选：提示词资产目录（默认 <项目根>/prompts）
WXBST_PROMPTS_DIR=

# 可选：远端向量检索（OpenAI 兼容 /embeddings；未配置时使用离线哈希向量）
EMBED_API_BASE=https://api.deepseek.com
EMBED_API_KEY=sk-请替换
EMBED_MODEL=text-embedding-3-small

# 本机自定义 provider z（与 DSH 相同；真实 Key 放 .env.local，勿提交）
LLM_API_BASE=https://api.ap-sub.top/v1
LLM_API_KEY=sk-请替换
LLM_MODEL=deepseek-v4.1-flash
LLM_SSL_VERIFY=false
